{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Run Main",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.c",
                "line.c",
                "debug.c",
                "chunk.c",
                "memory.c",
                "value.c",
                "vm.c",
                "-o",
                "main.out"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Run Executable",
            "command": "${workspaceFolder}/main.out",
            "dependsOn": "Run Main",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Builds and runs main.out"
        }
    ],
    "version": "2.0.0"
}